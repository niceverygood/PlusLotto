{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }],
  "functions": {
    "api/weekly-reco.ts": { "maxDuration": 300 },
    "api/weekly-lotto-sync.ts": { "maxDuration": 300 },
    "api/send-sms.ts": { "maxDuration": 30 },
    "api/transcribe-call.ts": { "maxDuration": 60 },
    "api/ingest-call-recording.ts": { "maxDuration": 30 },
    "api/analyze-call.ts": { "maxDuration": 45 },
    "api/resend-failed-sms.ts": { "maxDuration": 300 }
  },
  "crons": [
    { "path": "/api/weekly-lotto-sync", "schedule": "*/5 * * * *" },
    { "path": "/api/weekly-reco", "schedule": "*/5 0-2 * * *" },
    { "path": "/api/weekly-reco?audit=1", "schedule": "0 5 * * *" },
    { "path": "/api/resend-failed-sms", "schedule": "30 1 * * *" },
    { "path": "/api/resend-failed-sms", "schedule": "0 3 * * *" },
    { "path": "/api/resend-failed-sms", "schedule": "0 6 * * *" }
  ]
}
